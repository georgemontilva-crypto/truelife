# ─── Server ───────────────────────────────────────────────────────────────────

# Secret used to sign JWT session tokens. MUST be a long random string in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# MySQL connection string
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://root:password@localhost:3306/chronic_hemp

# Port the Express server listens on (default: 3000)
PORT=3000

# ─── OAuth (Manus, used for admin login) ──────────────────────────────────────

# Base URL of the Manus OAuth server
OAUTH_SERVER_URL=https://oauth.manus.app

# Your app's unique identifier registered with Manus
VITE_APP_ID=your-app-id-here

# openId of the owner account — this user is automatically assigned the admin role
OWNER_OPEN_ID=

# ─── AWS S3 (file uploads: product images, lab report PDFs, banners) ──────────

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Used to send verification codes and order confirmations.
# Get your API key at https://resend.com
# In development, emails are logged to the console instead of sent.
RESEND_API_KEY=re_your_resend_api_key

# ─── Built-in AI features (optional) ─────────────────────────────────────────
# API URL and key for the built-in LLM / image generation / voice features.
# Leave empty to disable AI features.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
